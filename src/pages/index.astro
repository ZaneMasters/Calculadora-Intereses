---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.jsx';
import CalculatorWrapper from '../components/CalculatorWrapper.jsx';
import BankComparison from '../components/BankComparison.jsx';
import SeoContent from '../components/SeoContent.astro';
---

<Layout
  title="Calculadora de Rendimientos Cuentas de Ahorro Colombia 2026"
  description="Calcula y compara rendimientos de Nu Cajitas, Pibank, Lulo, dale!, Bold y RappiPay en Colombia. Simula interés compuesto y retención en la fuente 2026."
>
  <Hero client:load />
  
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 -mt-8 relative z-20 pb-20 space-y-16">
    <section id="calculator-section">
      <CalculatorWrapper client:load />
    </section>
    
    <section id="comparison-section">
      <BankComparison client:load />
    </section>

    <section id="seo-guide-section">
      <SeoContent />
    </section>
  </div>
</Layout>

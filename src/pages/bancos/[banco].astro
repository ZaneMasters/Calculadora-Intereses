---
import Layout from '../../layouts/Layout.astro';
import CalculatorWrapper from '../../components/CalculatorWrapper.jsx';
import bankOptions from '../../utils/bankOptions.json';
import nuLogo from '../../assets/nu.png';
import popularLogo from '../../assets/bancopopular.png';
import ualaLogo from '../../assets/uala.png';
import luloLogo from '../../assets/lulo.png';
import pibankLogo from '../../assets/pibank.png';
import rappiLogo from '../../assets/rappipay.png';
import boldLogo from '../../assets/bold.png';
import global66Logo from '../../assets/global66.png';
import daleLogo from '../../assets/dale.svg?url';

const logoMap: Record<string, any> = {
  Nu: nuLogo,
  Uala: ualaLogo,
  Lulo: luloLogo,
  LuloPro: luloLogo,
  PiBank: pibankLogo,
  BancoPopularPlateada: popularLogo,
  RappiPayBolsillo: rappiLogo,
  BoldBolsillo: boldLogo,
  Global66: global66Logo,
  DaleBolsillo: daleLogo
};

const getLogoSrc = (asset: any) => (asset && typeof asset === 'object' && asset.src ? asset.src : asset);

export async function getStaticPaths() {
  const bankSlugMap = [
    { slug: 'pibank', key: 'PiBank', searchKeywords: 'pibank simulador, pibank rentabilidad, pibank colombia tasa' },
    { slug: 'nu-colombia', key: 'Nu', searchKeywords: 'simulador nubank colombia, simulador cajitas nu, calculadora nu, nubank rendimientos, cajitas nubank simulador, simulador cdt nu, simulador cajita nu colombia, tasa nu cajitas 2026' },
    { slug: 'lulo-bank', key: 'Lulo', searchKeywords: 'lulo bank rendimientos, simulador lulo flex, tasa lulo bank' },
    { slug: 'lulo-pro', key: 'LuloPro', searchKeywords: 'lulo pro rendimientos, tasa 10 lulo bank, simulador lulo pro' },
    { slug: 'dale', key: 'DaleBolsillo', searchKeywords: 'dale alcancias rendimientos, simulador dale grupo aval, tasa dale 10.5' },
    { slug: 'bold', key: 'BoldBolsillo', searchKeywords: 'bold bolsillos rendimientos, simulador bold cuenta, tasa bold 10' },
    { slug: 'rappipay', key: 'RappiPayBolsillo', searchKeywords: 'rappipay rendimientos, simulador rappicuenta, bovedas rappipay' },
    { slug: 'uala', key: 'Uala', searchKeywords: 'uala colombia rendimientos, simulador uala cuenta, tasa uala 2026' },
    { slug: 'banco-popular', key: 'BancoPopularPlateada', searchKeywords: 'cuenta plateada popular rendimientos, simulador banco popular' },
    { slug: 'global66', key: 'Global66', searchKeywords: 'global 66 rendimientos pesos, simulador global66 colombia' }
  ];

  return bankSlugMap.map(({ slug, key, searchKeywords }) => {
    const bank = bankOptions[key];
    return {
      params: { banco: slug },
      props: { bankKey: key, bank, slug, searchKeywords }
    };
  });
}

const { bankKey, bank, slug, searchKeywords } = Astro.props;

const isNu = bankKey === 'Nu';
const currentBankLogoSrc = getLogoSrc(logoMap[bankKey]) || '/logo.png';
const tasaPct = (bank.tasaEA * 100).toFixed(2);
const tasaNum = bank.tasaEA * 100;

// Cálculo estimativo para $1.000.000 COP
const gananciaMillon12Meses = Math.round(1000000 * bank.tasaEA);
const gananciaMillon1Mes = Math.round(1000000 * (Math.pow(1 + bank.tasaEA, 1/12) - 1));
const gananciaMillon1Dia = Math.round(1000000 * (Math.pow(1 + bank.tasaEA, 1/365) - 1));

// Tasa diaria equivalente por 365 días calendario
const tasaDiariaExacta = Math.pow(1 + bank.tasaEA, 1 / 365) - 1;
const tasaDiariaPct = (tasaDiariaExacta * 100).toFixed(5);

// Tabla de proyecciones para montos frecuentes ($1M, $3M, $10M, $30M, $50M)
const montosEjemplo = [
  { valor: 1000000, label: '$1.000.000 COP', tag: 'Ahorro base' },
  { valor: 3000000, label: '$3.000.000 COP', tag: 'Búsqueda popular' },
  { valor: 10000000, label: '$10.000.000 COP', tag: 'Ahorro medio' },
  { valor: 30000000, label: '$30.000.000 COP', tag: 'Búsqueda popular' },
  { valor: 50000000, label: '$50.000.000 COP', tag: 'Tope Seguro Fogafín' }
];

const limiteDiarioReteUVT = 3038; // 0.058 UVT en 2026 ($3.038 COP/día)

const tablaProyecciones = montosEjemplo.map(item => {
  const monto = item.valor;
  const tasaDiaria = Math.pow(1 + bank.tasaEA, 1 / 365) - 1;
  const tasaMensual = Math.pow(1 + bank.tasaEA, 1 / 12) - 1;
  
  const diarioBruto = Math.round(monto * tasaDiaria);
  const mensualBruto = Math.round(monto * tasaMensual);
  const anualBruto = Math.round(monto * bank.tasaEA);
  
  const aplicaRete = diarioBruto > limiteDiarioReteUVT;
  const reteMensual = aplicaRete ? Math.round(mensualBruto * 0.07) : 0;
  const mensualNeto = mensualBruto - reteMensual;
  const anualNeto = aplicaRete ? Math.round(anualBruto * 0.93) : anualBruto;

  return {
    ...item,
    diarioBruto,
    mensualBruto,
    mensualNeto,
    anualBruto,
    anualNeto,
    aplicaRete
  };
});

const title = isNu
  ? `Simulador Nu Colombia (Nubank) 2026 | Calculadora de Cajitas y Rendimientos`
  : `Simulador ${bank.nombre} 2026 | Rentabilidad y Rendimientos Reales`;

const description = isNu
  ? `Calcula cuánto rinde tu dinero en las Cajitas de Nu Colombia (Nubank) al ${tasaPct}% E.A. Simula tus ganancias para $1M, $3M y $30M con cálculo diario por 365 días y retención 2026.`
  : `Calcula cuánto rinde tu dinero en ${bank.nombre} con tasa del ${tasaPct}% E.A. Simula tus ganancias mensuales con cálculo diario, retención y comparativa 2026.`;

// Preguntas frecuentes especializadas
const nuFaqs = [
  {
    q: "¿Cuál es la tasa de interés de las Cajitas de Nu Colombia (Nubank) en 2026?",
    a: "Las Cajitas de Nu Colombia remuneran actualmente con una Tasa Efectiva Anual (E.A.) del 9.30%, con liquidación y abono diario de intereses desde $1 COP y liquidez disponible 24/7 sin cobro de cuota de manejo."
  },
  {
    q: "¿Cuánto dinero gano en Nu por $1.000.000, $3.000.000 y $30.000.000 COP?",
    a: "Bajo la tasa del 9.30% E.A.: con $1.000.000 ganas aprox. $7.430 COP al mes (~$93.000 al año); con $3.000.000 ganas aprox. $22.290 COP al mes (~$279.000 al año); y con $30.000.000 ganas aprox. $207.295 COP netos mensuales (luego del 7% de retención en la fuente por superar 0.058 UVT diarios), sumando más de $2.594.000 COP netos al año."
  },
  {
    q: "¿Cómo calcula Nu el rendimiento diario y por qué usa el factor 365 días?",
    a: "Nu liquida los rendimientos diarios dividiendo la base temporal en 365 días calendario mediante la fórmula matemática de interés compuesto: Tasa Diaria = (1 + 0.093)^(1/365) - 1 ≈ 0.02436% al día. Gracias a esta fórmula y al abono diario, tus intereses se reinvierten automáticamente generando interés compuesto real que totaliza el 9.30% E.A. al año."
  },
  {
    q: "¿Nu Colombia tiene CDT o qué son las Cajitas Congeladas?",
    a: "Nu Colombia no comercializa CDTs físicos tradicionales en papel. En su lugar, ofrece Cajitas de ahorro a la vista (con disponibilidad 24/7) y la funcionalidad de 'Cajitas Congeladas' a plazo fijo. Las Cajitas Congeladas operan con la misma lógica de un CDT digital: garantizan una tasa fija durante el plazo acordado y cuentan con la cobertura del Seguro de Depósitos de Fogafín."
  },
  {
    q: "¿Cuándo aplica retención en la fuente sobre los rendimientos en Nu?",
    a: "En Colombia para 2026, la retención en la fuente (7%) sobre rendimientos financieros aplica cuando los intereses diarios superan 0.058 UVT ($3.038 COP al día). Con la tasa de Nu del 9.30% E.A., tus ahorros están 100% libres de retención en la fuente si mantienes un saldo inferior a aproximadamente $12.470.000 COP."
  },
  {
    q: "¿Los depósitos en Nu Colombia cuentan con Seguro de Fogafín?",
    a: "Sí. Nu Colombia Compañía de Financiamiento S.A. es una entidad debidamente vigilada por la Superintendencia Financiera de Colombia. Todos los recursos depositados en la cuenta de ahorros y en las Cajitas cuentan con el Seguro de Depósitos de Fogafín hasta por $50.000.000 COP por titular."
  }
];

const standardFaqs = [
  {
    q: `¿Cuál es la tasa de interés de ${bank.nombre} en 2026?`,
    a: `${bank.nombre} remunera actualmente con una Tasa Efectiva Anual (E.A.) del ${tasaPct}%, con esquema de capitalización ${bank.capitalizacion}. ${bank.nota ? bank.nota + '.' : ''}`
  },
  {
    q: `¿Cuánto dinero gano al mes en ${bank.nombre} por cada $1.000.000 COP?`,
    a: `Por cada $1.000.000 COP ahorrado en ${bank.nombre}, recibes aproximadamente $${gananciaMillon1Mes.toLocaleString('es-CO')} COP en tu primer mes, proyectando una rentabilidad anual de aproximadamente $${gananciaMillon12Meses.toLocaleString('es-CO')} COP bajo interés compuesto.`
  },
  {
    q: `¿Los depósitos en ${bank.nombre} cuentan con Seguro de Fogafín?`,
    a: `Sí. Al ser una entidad vigilada por la Superintendencia Financiera de Colombia, los recursos depositados cuentan con el Seguro de Depósitos de Fogafín, con una cobertura de hasta $50.000.000 COP por titular.`
  }
];

const bankFaqs = isNu ? nuFaqs : standardFaqs;

const bankCustomSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "FinancialProduct",
      "name": isNu ? "Nu Colombia (Nubank Cajitas de Ahorro)" : bank.nombre,
      ...(isNu ? { "alternateName": ["Nubank Colombia", "Nu Cajitas", "Cuenta Nu", "Cajitas Nubank"] } : {}),
      "description": bank.descripcion,
      "annualPercentageRate": tasaNum,
      "interestRate": tasaNum,
      "url": bank.url,
      "feesAndCommissionsSpecification": "Sin cuota de manejo en transferencias seleccionadas"
    },
    {
      "@type": "FAQPage",
      "mainEntity": bankFaqs.map(faq => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.a
        }
      }))
    }
  ]
};

// Obtener otros bancos para la tabla comparativa
const otrosBancos = Object.entries(bankOptions)
  .filter(([key]) => key !== bankKey)
  .map(([key, val]) => ({ key, ...val }))
  .sort((a, b) => b.tasaEA - a.tasaEA)
  .slice(0, 4);
---

<Layout
  title={title}
  description={description}
  isHome={false}
  customSchema={bankCustomSchema}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-12">
    
    {/* Breadcrumbs de navegación */}
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 font-medium" aria-label="Breadcrumb">
      <a href="/" class="hover:text-blue-700 transition-colors">Inicio</a>
      <span>/</span>
      <span class="text-slate-400">Bancos</span>
      <span>/</span>
      <span class="inline-flex items-center gap-1.5 text-blue-700 font-semibold bg-white/80 border border-slate-200/80 px-2 py-0.5 rounded-lg">
        <img src={currentBankLogoSrc} alt="" class="w-4 h-4 rounded object-contain inline-block" />
        {isNu ? 'Nu Colombia (Nubank)' : bank.nombre}
      </span>
    </nav>

    {/* Hero Específico de la Entidad */}
    <header class="bg-gradient-to-r from-slate-900 via-blue-950 to-slate-900 text-white rounded-3xl p-5 sm:p-10 shadow-xl relative overflow-hidden border border-slate-800/80">
      {/* Patrón sutil y marca de agua coordinados con la entidad */}
      <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 24px 24px"></div>
      <div class="absolute -right-8 -bottom-8 w-44 h-44 sm:w-60 sm:h-60 pointer-events-none opacity-20 select-none transform rotate-12">
        <img src={currentBankLogoSrc} alt="" class="w-full h-full object-contain rounded-3xl" />
      </div>

      <div class="relative z-10 space-y-4 sm:space-y-5">
        <div class="flex items-center gap-3.5 flex-wrap">
          <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-white p-2 shadow-lg border border-white/20 shrink-0 flex items-center justify-center overflow-hidden">
            <img 
              src={currentBankLogoSrc} 
              alt={`Logo oficial ${bank.nombre}`} 
              class="w-full h-full object-contain"
              width="64"
              height="64"
              loading="eager"
            />
          </div>
          <div class="flex flex-col gap-1.5">
            <div class="inline-flex flex-wrap items-center gap-2">
              <span class="px-3 py-1 rounded-full bg-white/10 text-white text-xs font-semibold backdrop-blur-sm border border-white/15">
                🏦 Entidad Vigilada Superfinanciera & Fogafín
              </span>
              {isNu && (
                <span class="px-3 py-1 rounded-full bg-blue-900/60 text-blue-100 text-xs font-semibold border border-blue-400/30 backdrop-blur-sm">
                  Nu Colombia • Cajitas de Ahorro
                </span>
              )}
            </div>
          </div>
        </div>

        <h1 class="text-2xl sm:text-4xl md:text-5xl font-black tracking-tight leading-tight text-white">
          Simulador de Rendimientos <br class="hidden sm:block"/>
          <span class="text-emerald-400 drop-shadow-sm font-black">{isNu ? 'Nu Colombia (Nubank Cajitas)' : bank.nombre}</span>
        </h1>

        <p class="text-sm sm:text-lg text-slate-300 max-w-2xl leading-relaxed">
          {isNu 
            ? 'Calcula los rendimientos reales de tu dinero en las Cajitas de ahorro de Nu Colombia (Nubank). Conoce cuánto ganas por día y por mes con liquidación diaria al 9.30% E.A., retención en la fuente 2026 y respaldo Fogafín.'
            : bank.descripcion
          }
        </p>

        {/* Métricas clave */}
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-4 pt-4 border-t border-white/10">
          <div class="bg-white/10 border border-white/15 rounded-2xl p-3 sm:p-4 backdrop-blur-sm">
            <span class="text-[11px] sm:text-xs text-slate-300 font-medium block">Tasa Efectiva Anual</span>
            <span class="text-xl sm:text-3xl font-extrabold text-white">{tasaPct}%</span>
            <span class="text-[10px] sm:text-[11px] text-slate-400 block mt-0.5">E.A. vigente 2026</span>
          </div>

          <div class="bg-white/10 border border-white/15 rounded-2xl p-3 sm:p-4 backdrop-blur-sm">
            <span class="text-[11px] sm:text-xs text-slate-300 font-medium block">Capitalización</span>
            <span class="text-lg sm:text-2xl font-bold text-white capitalize">{bank.capitalizacion}</span>
            <span class="text-[10px] sm:text-[11px] text-slate-400 block mt-0.5">Interés compuesto</span>
          </div>

          <div class="bg-white/10 border border-white/15 rounded-2xl p-3 sm:p-4 backdrop-blur-sm">
            <span class="text-[11px] sm:text-xs text-slate-300 font-medium block">Rendimiento diario ($1M)</span>
            <span class="text-lg sm:text-2xl font-bold text-emerald-400 break-words">+${gananciaMillon1Dia.toLocaleString('es-CO')}</span>
            <span class="text-[10px] sm:text-[11px] text-slate-400 block mt-0.5">Por cada $1.000.000 COP</span>
          </div>

          <div class="bg-white/10 border border-white/15 rounded-2xl p-3 sm:p-4 backdrop-blur-sm">
            <span class="text-[11px] sm:text-xs text-slate-300 font-medium block">Seguro Fogafín</span>
            <span class="text-lg sm:text-2xl font-bold text-white">$50M COP</span>
            <span class="text-[10px] sm:text-[11px] text-slate-400 block mt-0.5">Por titular vigilado</span>
          </div>
        </div>
      </div>
    </header>

    {/* Calculadora interactiva precargada con este banco */}
    <section class="space-y-4">
      <div class="text-center max-w-2xl mx-auto space-y-1">
        <h2 class="text-xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Simula tus ganancias en {isNu ? 'Nu Colombia (Nubank)' : bank.nombre}
        </h2>
        <p class="text-xs sm:text-sm text-slate-600">
          Ajusta cualquier monto y plazo personalizado para calcular intereses netos, retención y crecimiento compuesto.
        </p>
      </div>

      <div class="bg-white rounded-3xl p-2 sm:p-6 shadow-sm border border-slate-200">
        <CalculatorWrapper client:load initialBank={bankKey} />
      </div>
    </section>

    {/* Tabla de Rendimientos Rápidos por Montos Frecuentes */}
    <section class="space-y-6">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold mb-2 border border-emerald-100">
          <span>⚡</span> Proyección Rápida de Ganancias
        </div>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
          ¿Cuánto ganas en {isNu ? 'Nu (Nubank)' : bank.nombre} según tu inversión?
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-1">
          Estimaciones directas para los montos más consultados en Colombia considerando la tasa del {tasaPct}% E.A. y el impacto de la retención en la fuente DIAN:
        </p>
      </div>

      {/* Versión Desktop: Tabla estilizada */}
      <div class="hidden sm:block overflow-hidden bg-white border border-slate-200 rounded-3xl shadow-sm">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-50 border-b border-slate-200 text-slate-600 font-semibold text-xs uppercase tracking-wider">
            <tr>
              <th scope="col" class="py-4 px-6">Monto Invertido</th>
              <th scope="col" class="py-4 px-6">Rendimiento Diario</th>
              <th scope="col" class="py-4 px-6">Ganancia al Mes (1)</th>
              <th scope="col" class="py-4 px-6">Ganancia al Año (Neto)</th>
              <th scope="col" class="py-4 px-6">Retención DIAN (7%)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 font-medium text-slate-700">
            {tablaProyecciones.map((row) => (
              <tr class="hover:bg-slate-50/80 transition-colors">
                <td class="py-4 px-6">
                  <div class="font-bold text-slate-900 text-base">{row.label}</div>
                  <span class={`text-[10px] font-semibold px-2 py-0.5 rounded-full inline-block mt-0.5 ${
                    row.monto === 50000000 
                      ? 'bg-amber-100 text-amber-800' 
                      : 'bg-blue-50 text-blue-700'
                  }`}>
                    {row.tag}
                  </span>
                </td>
                <td class="py-4 px-6 text-slate-900 font-semibold">
                  +${row.diarioBruto.toLocaleString('es-CO')} COP
                </td>
                <td class="py-4 px-6">
                  <span class="text-emerald-600 font-bold text-base">
                    +${(row.aplicaRete ? row.mensualNeto : row.mensualBruto).toLocaleString('es-CO')} COP
                  </span>
                  {row.aplicaRete && (
                    <span class="block text-[11px] text-slate-400">Bruto: ${row.mensualBruto.toLocaleString('es-CO')}</span>
                  )}
                </td>
                <td class="py-4 px-6">
                  <span class="text-blue-800 font-extrabold text-base">
                    +${row.anualNeto.toLocaleString('es-CO')} COP
                  </span>
                  <span class="block text-[11px] text-slate-400">Bajo interés compuesto</span>
                </td>
                <td class="py-4 px-6">
                  {row.aplicaRete ? (
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-amber-50 text-amber-700 text-xs font-semibold">
                      <span>⚠️</span> Aplica 7% (Supera 0.058 UVT)
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold">
                      <span>✓</span> 100% Exento
                    </span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {/* Versión Mobile: Tarjetas compactas */}
      <div class="sm:hidden space-y-3">
        {tablaProyecciones.map((row) => (
          <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm space-y-3">
            <div class="flex items-center justify-between">
              <div>
                <span class="font-extrabold text-slate-900 text-lg block">{row.label}</span>
                <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 inline-block">
                  {row.tag}
                </span>
              </div>
              <div class="text-right">
                <span class="text-xs text-slate-400 block">Rendimiento diario</span>
                <span class="font-bold text-slate-800 text-sm">+${row.diarioBruto.toLocaleString('es-CO')}</span>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-2 pt-2 border-t border-slate-100 text-xs">
              <div class="bg-slate-50 p-2 rounded-xl">
                <span class="text-slate-400 block text-[11px]">Ganancia mes (neto)</span>
                <span class="font-bold text-emerald-600 text-sm">
                  +${(row.aplicaRete ? row.mensualNeto : row.mensualBruto).toLocaleString('es-CO')}
                </span>
              </div>
              <div class="bg-slate-50 p-2 rounded-xl">
                <span class="text-slate-400 block text-[11px]">Ganancia año (neto)</span>
                <span class="font-bold text-blue-800 text-sm">+${row.anualNeto.toLocaleString('es-CO')}</span>
              </div>
            </div>

            <div class="text-[11px]">
              {row.aplicaRete ? (
                <span class="text-amber-700 font-semibold block">⚠️ Aplica 7% retención DIAN (supera $3.038 COP/día)</span>
              ) : (
                <span class="text-emerald-700 font-semibold block">✓ Exento de retención en la fuente</span>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* Explicación Matemática: Fórmula por 365 días */}
    <section class="bg-gradient-to-br from-slate-950 via-slate-900 to-blue-950 text-white rounded-3xl p-6 sm:p-10 shadow-lg space-y-6 border border-slate-800">
      <div class="max-w-3xl space-y-2">
        <span class="px-3 py-1 rounded-full bg-blue-500/15 text-blue-300 text-xs font-semibold border border-blue-400/25 inline-block">
          📐 Transparencia y Metodología
        </span>
        <h2 class="text-xl sm:text-3xl font-extrabold tracking-tight">
          ¿Cómo se calcula el rendimiento diario {isNu ? 'de Nu (por 365 días)' : `en ${bank.nombre}`}?
        </h2>
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
          En Colombia, {isNu ? 'Nu liquida los intereses de sus Cajitas' : `${bank.nombre} remunera tu capital`} tomando como base el año calendario de <strong>365 días</strong> y la tasa Efectiva Anual (E.A.).
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-white/5 border border-white/10 rounded-2xl p-5 space-y-2">
          <span class="text-xs font-semibold text-blue-300 uppercase tracking-wider block">Fórmula de Conversión Diaria</span>
          <p class="text-sm font-mono bg-black/40 p-3 rounded-xl text-emerald-300">
            Tasa Diaria = (1 + Tasa E.A.)^(1/365) - 1
          </p>
          <p class="text-xs text-slate-400 leading-relaxed">
            Para la tasa actual del <strong>{tasaPct}% E.A.</strong>, la tasa efectiva diaria corresponde a <strong>{tasaDiariaPct}% al día</strong>.
          </p>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-5 space-y-2">
          <span class="text-xs font-semibold text-blue-300 uppercase tracking-wider block">¿Por qué no es una división simple?</span>
          <p class="text-xs text-slate-300 leading-relaxed">
            Si se dividiera linealmente ({tasaPct}% ÷ 365 = {(tasaNum / 365).toFixed(4)}%), se trataría de una tasa nominal. La fórmula exponencial garantiza que los intereses ganados hoy generen nuevos intereses mañana (<strong>interés compuesto diario</strong>), completando exactamente el {tasaPct}% al cabo de 365 días.
          </p>
        </div>
      </div>
    </section>

    {/* Sección específica Nu: Cajitas vs CDT */}
    {isNu && (
      <section class="space-y-6">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold mb-2 border border-emerald-100">
            <span>⚖️</span> Comparativa Directa
          </div>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
            ¿Cajitas Nu o un CDT Tradicional en Colombia?
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 mt-1">
            Diferencias clave entre ahorrar en las Cajitas de Nu Colombia y abrir un Certificado de Depósito a Término:
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-2">
            <div class="text-2xl">⚡</div>
            <h3 class="font-bold text-slate-900 text-base">Liquidez Inmediata</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              En las Cajitas puedes retirar tu dinero las 24 horas del día sin penalidades ni trámites, a diferencia del CDT que bloquea el capital hasta el vencimiento.
            </p>
          </div>

          <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-2">
            <div class="text-2xl">📈</div>
            <h3 class="font-bold text-slate-900 text-base">Abono Diario de Intereses</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Tus intereses se liquidan y pagan cada 24 horas en tu cajita. Puedes ver crecer tu saldo todos los días y disponer de los rendimientos cuando los necesites.
            </p>
          </div>

          <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-2">
            <div class="text-2xl">🔒</div>
            <h3 class="font-bold text-slate-900 text-base">Cajitas Congeladas</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Si deseas un esquema similar a un CDT para evitar gastar tu dinero, Nu cuenta con la opción de congelar cajitas por plazos fijados garantizando la tasa pactada.
            </p>
          </div>

          <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-2">
            <div class="text-2xl">🛡️</div>
            <h3 class="font-bold text-slate-900 text-base">Misma Cobertura Fogafín</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Tanto un CDT en un banco tradicional como tu saldo en Nu Colombia cuentan con el mismo respaldo legal de Fogafín de hasta $50.000.000 COP por titular.
            </p>
          </div>
        </div>
      </section>
    )}

    {/* Comparativa Directa con Alternativas */}
    <section class="space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
            ¿Cómo se compara {isNu ? 'Nu Colombia' : bank.nombre} frente a otros bancos?
          </h2>
          <p class="text-xs sm:text-sm text-slate-500">
            Comparativa de tasas de interés y condiciones con las alternativas líderes en Colombia.
          </p>
        </div>
        <a href="/" class="text-xs sm:text-sm font-semibold text-blue-700 hover:text-blue-900 transition-colors inline-flex items-center gap-1" aria-label="Ver ranking completo de cuentas de ahorro en Colombia">
          Ver ranking completo
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {otrosBancos.map((otro) => (
          <div class="bg-white p-5 rounded-2xl border border-slate-200 hover:border-blue-300 transition-[border-color,box-shadow] duration-150 ease-out shadow-sm space-y-3 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="text-xs font-semibold text-slate-400">Alternativa</span>
                <div class="w-8 h-8 rounded-lg bg-white p-1 border border-slate-100 shadow-sm flex items-center justify-center overflow-hidden">
                  <img src={getLogoSrc(logoMap[otro.key]) || '/logo.png'} alt={otro.nombre} class="w-full h-full object-contain" width="32" height="32" loading="lazy" />
                </div>
              </div>
              <h3 class="font-bold text-slate-900 text-base">{otro.nombre}</h3>
              <p class="text-xs text-slate-500 mt-1 line-clamp-2">{otro.descripcion}</p>
            </div>
            <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
              <div>
                <span class="text-xs text-slate-400 block">Tasa E.A.</span>
                <span class="text-lg font-black text-blue-900">{(otro.tasaEA * 100).toFixed(2)}%</span>
              </div>
              <span class="text-xs px-2 py-1 rounded-lg bg-slate-100 text-slate-600 font-medium capitalize">
                {otro.capitalizacion}
              </span>
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* Preguntas Frecuentes Específicas */}
    <section class="space-y-6">
      <div class="text-center max-w-xl mx-auto space-y-1">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
          Preguntas Frecuentes sobre {isNu ? 'Nu Colombia (Nubank)' : bank.nombre}
        </h2>
        <p class="text-xs sm:text-sm text-slate-500">
          Respuestas a las dudas más comunes sobre rentabilidad, impuestos y seguridad.
        </p>
      </div>

      <div class="max-w-3xl mx-auto space-y-3">
        {bankFaqs.map((faq) => (
          <details class="group bg-white rounded-2xl border border-slate-200 p-5 open:shadow-sm open:border-blue-200 transition-[border-color,box-shadow] duration-150 ease-out">
            <summary class="flex justify-between items-center font-bold text-slate-900 cursor-pointer list-none text-sm sm:text-base select-none gap-4">
              <span>{faq.q}</span>
              <span class="text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              </span>
            </summary>
            <div class="mt-4 text-sm text-slate-600 leading-relaxed border-t border-slate-100 pt-3">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    {/* Enlaces de soporte normativo y guías */}
    <footer class="bg-slate-100/70 border border-slate-200 rounded-2xl p-6 text-center space-y-3">
      <h3 class="text-sm font-bold text-slate-700">¿Quieres profundizar en las fórmulas y normativas?</h3>
      <div class="flex flex-wrap items-center justify-center gap-4 text-xs sm:text-sm font-semibold text-blue-700">
        <a href="/explicacion/" class="hover:underline">Guía matemática de cálculo de interés</a>
        <span>•</span>
        <a href="/topes/" class="hover:underline">Límites UVT y exención del 4x1000 2026</a>
        <span>•</span>
        <a href="/" class="hover:underline">Volver a la Calculadora General</a>
      </div>
    </footer>

  </div>
</Layout>

